# Flowlearn MCP credentials.
#
# Recommended: don't fill this in by hand. Run
#     python scripts/register.py
# It prompts for email + password, signs in to flowlearn.io, auto-picks your
# tenant from /api/register/memberships (or asks if you admin more than one),
# and writes a real .env for you.
#
# Manual fallback (Docker / MCP JSON config / CI): copy this file to .env and
# fill in the values below. .env is gitignored — never commit real credentials.

FLOWLEARN_EMAIL=
FLOWLEARN_PASSWORD=

# Auto-discovered by scripts/register.py from your tenant memberships after
# login. Only set this manually if you're skipping register.py (e.g. wiring
# the server straight into a Docker run or a Claude config JSON).
FLOWLEARN_TENANT_SLUG=
